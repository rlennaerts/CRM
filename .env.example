# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crm_hub

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# App
SECRET_KEY=change-this-to-a-random-secret-key
APP_ENV=development

# mijn.vwe credentials
VWE_BASE_URL=https://mijn.vwe.nl
VWE_USERNAME=
VWE_PASSWORD=

# Gaston export folder (where exported files land)
GASTON_EXPORT_DIR=/data/imports/gaston

# SAM export folder
SAM_EXPORT_DIR=/data/imports/sam

# Notification settings (optioneel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Sync intervals (in minutes)
VWE_SYNC_INTERVAL=30
GASTON_SYNC_INTERVAL=15
SAM_SYNC_INTERVAL=15
